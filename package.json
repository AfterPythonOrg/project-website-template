{
	"name": "@afterpython/project-website-template",
	"version": "0.3.9",
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@11.1.1",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build && pagefind --site build",
		"build:watch": "vp build --watch --mode development",
		"preview": "vp preview",
		"serve": "pnpx serve build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "vp fmt .",
		"lint": "vp fmt --check . && vp lint .",
		"test:unit": "vp test",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@pagefind/component-ui": "^1.6.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"eslint-plugin-svelte": "^3.24.0",
		"highlight.js": "^11.12.0",
		"jsdom": "^31.0.0",
		"marked": "^18.1.3",
		"marked-gfm-heading-id": "^4.1.4",
		"marked-highlight": "^2.2.4",
		"mdsvex": "^0.12.8",
		"pagefind": "^1.6.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#static/*": "./static/*"
	}
}
